# Limitless API Configuration
LIMITLESS_API_KEY=YOUR_LIMITLESS_API_KEY_HERE
LIMITLESS_CHATS_API_BASE=https://api.limitless.ai/v1/chats
LIMITLESS_LIFELOGS_API_BASE=https://api.limitless.ai/v1/lifelogs

# LLM Provider Configuration (openai or ollama)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4

# Ollama Configuration
OLLAMA_MODEL=llama3.2

# Directory Paths (relative to project root)
LIFELOGS_DIR=lifelogs
INSIGHTS_DIR=daily
WEEKLY_DIR=weekly
MONTHLY_DIR=monthly
BEE_DIR=bee
PSYCHOLOGIST_DIR=psychologist
JOURNAL_DIR=journal

# Prompt File Paths
WEEKLY_PROMPT_FILE=prompts/weekly_prompt.txt
MONTHLY_PROMPT_FILE=prompts/monthly.txt
BEE_PROMPT_FILE=prompts/bee_daily.txt
PSYCHOLOGIST_PROMPT_FILE=prompts/psycho_analysis.txt

# Therapy Detection Parameters
THERAPY_KEYWORDS=therapy,therapist,psychologist,counseling,mental health,anxiety,depression,trauma,coping
NON_THERAPY_KEYWORDS=journal,note to self,reminder,todo,grocery,shopping,meeting,calendar
CONVERSATION_GAP_MINUTES=15

# Therapy Scoring Parameters
SCORE_DURATION_MATCH=30
SCORE_AFTERNOON=10
SCORE_KEYWORD=15
SCORE_SPEAKER_NAMES=20
SCORE_BACK_AND_FORTH=15
PENALTY_TOO_MANY_SPEAKERS=-20
PENALTY_TOO_LONG=-15
PENALTY_TOO_SHORT=-20
PENALTY_TOO_MANY_MESSAGES=-10
PENALTY_JOURNAL=-30
PENALTY_NON_THERAPY=-25
CONFIDENCE_THRESHOLD=50

# Therapy Detection Thresholds
MAX_DURATION=75
MIN_DURATION=30
MIN_MESSAGES=8
MAX_MESSAGES=100
MAX_SPEAKERS=3

# ============================================================================
# Feature Toggles
# ============================================================================
# Control which parts of the pipeline execute. Set to "true" to enable,
# "false" to disable. Accepts: true/false, yes/no, 1/0, on/off (case-insensitive)

# FETCH_LIFELOGS - Fetch new lifelogs from Limitless API
# When disabled: Skips API calls, uses only existing local lifelog files
# Use case: Disable during development to avoid unnecessary API calls
FETCH_LIFELOGS=true

# FETCH_DAILY_INSIGHTS - Fetch daily insights/chats from Limitless API
# When disabled: Skips API calls, uses only existing local insight files
# Use case: Disable when only processing lifelogs or generating summaries
FETCH_DAILY_INSIGHTS=true

# PROCESS_BEE_TRANSCRIPTIONS - Process Bee transcription files into daily insights
# When disabled: Skips Bee file processing, no LLM calls for transcriptions
# Use case: Disable if not using Bee transcriptions or to reduce processing time
PROCESS_BEE_TRANSCRIPTIONS=true

# PROCESS_JOURNAL_ENTRIES - Format and process personal journal entries
# When disabled: Skips journal entry formatting, no LLM calls for journal processing
# Use case: Disable if not recording journal entries or to reduce processing time
PROCESS_JOURNAL_ENTRIES=true

# PROCESS_THERAPY_SESSIONS - Detect and analyze therapy sessions in lifelogs
# When disabled: Skips therapy session detection and clinical analysis
# Use case: Disable if not tracking therapy or to reduce processing time
PROCESS_THERAPY_SESSIONS=true

# CREATE_WEEKLY_SUMMARIES - Generate weekly summary reports
# When disabled: Skips weekly aggregation, saves processing time
# Use case: Disable if only daily insights are needed
CREATE_WEEKLY_SUMMARIES=true

# CREATE_MONTHLY_SUMMARIES - Generate monthly summary reports
# When disabled: Skips monthly aggregation, saves processing time
# Use case: Disable if only daily/weekly insights are needed
CREATE_MONTHLY_SUMMARIES=true

# LABEL_SPEAKERS - Identify and label speakers in lifelog transcripts
# When disabled: Skips LLM-based speaker identification, faster processing
# Use case: Disable to reduce LLM API costs or speed up processing
LABEL_SPEAKERS=true

# ============================================================================
# Logging Configuration
# ============================================================================
# Control logging behavior, output, and verbosity

# LOG_LEVEL - Minimum log level to display/record
# Options: DEBUG (most verbose), INFO, WARNING, ERROR, CRITICAL (least verbose)
# DEBUG: Detailed diagnostic information for troubleshooting
# INFO: General informational messages about application flow (recommended for production)
# WARNING: Potentially harmful situations that don't prevent operation
# ERROR: Error events that might still allow application to continue
# CRITICAL: Very severe errors that may cause application to abort
LOG_LEVEL=INFO

# LOG_TO_CONSOLE - Display logs in terminal
# When disabled: No console output (only file logging if enabled)
# Use case: Disable for background jobs or when only file logging desired
LOG_TO_CONSOLE=true

# LOG_TO_FILE - Save logs to file with automatic rotation
# When disabled: Logs only to console, not persisted to disk
# Use case: Disable for development if you don't need log files
LOG_TO_FILE=true

# LOG_DIR - Directory where log files are stored
# Default: logs/ (created automatically if doesn't exist)
LOG_DIR=logs

# LOG_FILE - Name of the main log file
# Rotated files will be named: daily_insights.log.1, .log.2, etc.
LOG_FILE=daily_insights.log

# LOG_MAX_BYTES - Maximum size of log file before rotation (in bytes)
# Default: 10485760 (10MB)
# When file reaches this size, it's rotated to .log.1 and a new file is created
# Examples: 5242880 (5MB), 20971520 (20MB), 52428800 (50MB)
LOG_MAX_BYTES=10485760

# LOG_BACKUP_COUNT - Number of backup log files to keep
# Default: 5 (keeps 50MB total with 10MB files)
# Oldest backup is deleted when limit is reached
# Example: With LOG_MAX_BYTES=10MB and LOG_BACKUP_COUNT=5, you keep ~50MB of logs
LOG_BACKUP_COUNT=5
