# Limitless API Configuration
LIMITLESS_API_KEY=YOUR_LIMITLESS_API_KEY_HERE
LIMITLESS_CHATS_API_BASE=https://api.limitless.ai/v1/chats
LIMITLESS_LIFELOGS_API_BASE=https://api.limitless.ai/v1/lifelogs

# LLM Provider Configuration (openai or ollama)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4

# Ollama Configuration
OLLAMA_MODEL=llama3.2

# Directory Paths (relative to project root)
LIFELOGS_DIR=lifelogs
INSIGHTS_DIR=daily
WEEKLY_INSIGHTS_DIR=weekly
MONTHLY_INSIGHTS_DIR=monthly
BEE_DIR=bee
THERAPY_DIR=psychologist
THERAPY_MONTHLY_DIR=therapy_monthly
JOURNAL_DIR=journal
JOURNAL_MONTHLY_DIR=journal_monthly
DOCTOR_DIR=doctor
BIOGRAPHIES_DIR=biographies

# Prompt File Paths
WEEKLY_INSIGHTS_PROMPT=prompts/weekly_prompt.txt
MONTHLY_INSIGHTS_PROMPT=prompts/monthly.txt
BEE_PROMPT_FILE=prompts/bee_daily.txt
THERAPY_PROMPT=prompts/psycho_analysis.txt
THERAPY_MONTHLY_PROMPT=prompts/therapy_monthly.txt
JOURNAL_MONTHLY_PROMPT=prompts/journal_monthly.txt
DOCTOR_PROMPT=prompts/doctor_visit.txt
BIOGRAPHY_PROMPT=prompts/person_place_thing.txt
BIOGRAPHY_LIGHT_PROMPT=prompts/biography_light_extraction.txt
BIOGRAPHY_SYNTHESIS_PROMPT=prompts/biography_synthesis.txt
BIOGRAPHY_DETECTION_PROMPT=prompts/biography_detection.txt

# ============================================================================
# Therapy Detection Parameters (MVP Phase 0 + Enhancements)
# ============================================================================
# Evolved from 3 to 4 parameters with strict validation

# EXPECTED_SPEAKERS_THERAPY_SESSION - Comma-separated list of allowed speakers
# Phase 2.5: ONLY these speakers can be present in therapy sessions
# Any conversation with speakers not in this list will be rejected
# Example: "Bruce,Larry,Unknown" or "John,Dr. Smith,Unknown"
EXPECTED_SPEAKERS_THERAPY_SESSION=Bruce,Larry,Unknown

# THERAPY_KEYWORDS - Comma-separated list of therapy-related keywords
# Phase 2: Required alongside speaker validation (Boolean AND logic)
# Keep this minimal and specific to reduce false positives
THERAPY_KEYWORDS=therapy,therapist

# THERAPY_KEYWORD_MIN - Minimum number of therapy keywords required
# Prevents false positives from single generic keyword matches
# Default: 2 (require multiple therapy-related terms)
THERAPY_KEYWORD_MIN=2

# THERAPY_MIN_DURATION - Minimum duration in minutes for therapy sessions
# Default: 30 minutes (typical therapy sessions are 45-60 minutes)
THERAPY_MIN_DURATION=30

# THERAPY_MAX_DURATION - Maximum duration in minutes for therapy sessions
# Prevents false positives from very long conversations spanning multiple activities
# Typical therapy sessions are 45-60 minutes, extended sessions up to 90 minutes
# Default: 120 minutes (2 hours) - allows extended sessions while filtering extremes
# Set to 0 or empty to disable maximum duration check
THERAPY_MAX_DURATION=120

# THERAPY_EXCLUSION_KEYWORDS - Comma-separated keywords that indicate non-therapy contexts
# Phase 2.9: Rejects conversations containing administrative, political, travel, or social terms
# These keywords help filter false positives from eligibility interviews, political discussions, etc.
# Default examples: eligibility, interview, application, trump, election, protest, airport, customs
# Customize this list based on your specific false positive patterns
THERAPY_EXCLUSION_KEYWORDS=eligibility,interview,application,appeal,claim,trump,election,protest,voting,airport,customs,border

# ============================================================================
# Doctor Visit Detection Parameters
# ============================================================================

# EXPECTED_SPEAKERS_DOCTOR_VISIT - Comma-separated list of allowed speakers
# Only these speakers can be present in doctor visit conversations
# Any conversation with speakers not in this list will be rejected
# Example: "Bruce,Unknown" or "John,Dr. Smith,Unknown"
EXPECTED_SPEAKERS_DOCTOR_VISIT=Bruce,Unknown

# DOCTOR_KEYWORDS - Comma-separated list of medical-related keywords
# Used to identify doctor visits in conversation transcripts
# Keep this comprehensive to catch various medical contexts
DOCTOR_KEYWORDS=doctor,physician,specialist,appointment,checkup,prescription,symptoms,diagnosis,medical,clinic,hospital

# DOCTOR_KEYWORD_MIN - Minimum number of doctor keywords required
# Prevents false positives from single generic keyword matches
# Default: 2 (require multiple medical-related terms)
DOCTOR_KEYWORD_MIN=2

# DOCTOR_MIN_DURATION - Minimum duration in minutes for doctor visits
# Default: 10 minutes (typical quick checkups and appointments)
DOCTOR_MIN_DURATION=10

# DOCTOR_MAX_DURATION - Maximum duration in minutes for doctor visits
# Prevents false positives from very long conversations spanning multiple activities
# Typical doctor visits are 15-45 minutes
# Default: 90 minutes - Set to 0 to disable maximum duration check
DOCTOR_MAX_DURATION=90

# DOCTOR_EXCLUSION_KEYWORDS - Comma-separated keywords that indicate non-medical visits
# Rejects conversations containing mental health/psychiatry terms to separate from therapy
# These visits should be handled by the therapy session detection instead
# Default: psychiatrist, therapy, therapist, counseling, psychologist, mental health
DOCTOR_EXCLUSION_KEYWORDS=psychiatrist,therapy,therapist,counseling,psychologist,mental health

# ============================================================================
# Doctor Visit Confidence Scoring Weights
# ============================================================================
# Confidence scoring helps distinguish actual doctor visits from false positives
# Each weight is applied when its corresponding pattern is detected
# Final confidence score ranges from 0.0 (unlikely) to 1.0 (certain)

# DOCTOR_CONFIDENCE_WEIGHT_EXAMINATION - Weight for examination-specific keywords
# Keywords: examine, exam, examined, examination, physical, diagnosed, prescription
# Positive indicator: +0.3 suggests actual doctor visit vs. casual health discussion
# Example: "The doctor examined my throat" → adds +0.3 to confidence
DOCTOR_CONFIDENCE_WEIGHT_EXAMINATION=0.3

# DOCTOR_CONFIDENCE_WEIGHT_HEALTH_METRICS - Weight for health metrics keywords
# Keywords: weight, weigh, blood pressure, glucose, A1C
# Negative indicator: -0.2 reduces confidence for personal logging patterns
# Example: "My weight was 188 pounds today" → subtracts -0.2 from confidence
DOCTOR_CONFIDENCE_WEIGHT_HEALTH_METRICS=-0.2

# DOCTOR_CONFIDENCE_WEIGHT_DISCUSSION_PATTERN - Weight for discussion patterns
# Patterns: "doctor said", "appointment with", "going to see", "doctor told"
# Negative indicator: -0.3 reduces confidence for discussing visits vs. being in visit
# Example: "The doctor said I should exercise" → subtracts -0.3 from confidence
DOCTOR_CONFIDENCE_WEIGHT_DISCUSSION_PATTERN=-0.3

# DOCTOR_CONFIDENCE_WEIGHT_BIDIRECTIONAL_QA - Weight for bidirectional Q&A patterns
# Positive indicator: +0.3 suggests actual clinical conversation
# Detects when both patient and provider ask/answer questions
# Example: Provider asks symptoms, patient describes, provider explains → adds +0.3
DOCTOR_CONFIDENCE_WEIGHT_BIDIRECTIONAL_QA=0.3

# DOCTOR_CONFIDENCE_WEIGHT_DURATION_OPTIMAL - Weight for duration in optimal range
# Positive indicator: +0.2 when duration is in typical doctor visit sweet spot
# Sweet spot calculated from DOCTOR_MIN_DURATION and DOCTOR_MAX_DURATION
# Example: 35-minute conversation in 10-90 minute range → adds +0.2 to confidence
DOCTOR_CONFIDENCE_WEIGHT_DURATION_OPTIMAL=0.2

# ============================================================================
# Conversation Grouping (Used by multiple features)
# ============================================================================
# Maximum time gap in minutes between messages to group as same conversation
CONVERSATION_GAP_MINUTES=15

# ============================================================================
# Journal Detection Parameters
# ============================================================================

# Minimum number of consecutive messages after "journal" keyword
# to qualify as a sustained journal entry (not just mentioning journals)
# Lower values catch shorter entries but risk false positives
# Higher values ensure substantive content but may miss brief reflections
# Recommended: 5-10 messages
JOURNAL_MIN_MESSAGES=5

# Minimum total word count across all messages in journal session
# Ensures substantive content, filters out brief notes like "journal reminder"
# Count includes all words after "journal" keyword through end of conversation
# Recommended: 50-150 words
JOURNAL_MIN_WORDS=100

# Valid speaker labels for journal entries (comma-separated)
# Only conversations from these speakers will be considered journals
# Common labels: Bruce (identified user), Unknown (unidentified/default)
# Default: Bruce,Unknown
JOURNAL_VALID_SPEAKERS=Bruce,Unknown

# End marker phrases for journal completion detection (comma-separated)
# Phrases that indicate the user is closing the journal entry
# Uses flexible regex matching to handle natural speech variations
# Empty string disables end marker detection entirely
# Examples: "end journal", "journal end", "that's all", "end of entry"
# Default: "end journal,journal end"
JOURNAL_END_MARKERS=end journal,journal end

# ============================================================================
# Monthly Summary Parameters
# ============================================================================

# MONTHLY_MIN_WEEKS - Minimum weekly summaries required for monthly summary
# Controls when a monthly insight summary is generated from weekly summaries
# Default: 4 (a complete month typically has 4-5 weeks)
# Set to 3 or lower to generate summaries for months with fewer weeks
# Example: Set to 3 to generate summaries for months with only 3 weeks
# Note: Weeks are grouped by their start_date, not end_date
MONTHLY_MIN_WEEKS=4

# ============================================================================
# Therapy Monthly Summary Parameters
# ============================================================================

# THERAPY_MONTHLY_MIN_SESSIONS - Minimum therapy sessions required for monthly summary
# Controls when a monthly therapy summary is generated
# Default: 1 (generate summary even with a single session)
# Increase if you want to require multiple sessions before creating summary
# Example: Set to 2 to require at least 2 sessions per month
THERAPY_MONTHLY_MIN_SESSIONS=1

# ============================================================================
# Feature Toggles
# ============================================================================
# Control which parts of the pipeline execute. Set to "true" to enable,
# "false" to disable. Accepts: true/false, yes/no, 1/0, on/off (case-insensitive)

# FETCH_LIFELOGS - Fetch new lifelogs from Limitless API
# When disabled: Skips API calls, uses only existing local lifelog files
# Use case: Disable during development to avoid unnecessary API calls
FETCH_LIFELOGS=true

# FETCH_DAILY_INSIGHTS - Fetch daily insights/chats from Limitless API
# When disabled: Skips API calls, uses only existing local insight files
# Use case: Disable when only processing lifelogs or generating summaries
FETCH_DAILY_INSIGHTS=true

# PROCESS_BEE_TRANSCRIPTIONS - Process Bee transcription files into daily insights
# When disabled: Skips Bee file processing, no LLM calls for transcriptions
# Use case: Disable if not using Bee transcriptions or to reduce processing time
PROCESS_BEE_TRANSCRIPTIONS=true

# PROCESS_JOURNAL_ENTRIES - Format and process personal journal entries
# When disabled: Skips journal entry formatting, no LLM calls for journal processing
# Use case: Disable if not recording journal entries or to reduce processing time
PROCESS_JOURNAL_ENTRIES=true

# PROCESS_THERAPY_SESSIONS - Detect and analyze therapy sessions in lifelogs
# When disabled: Skips therapy session detection and clinical analysis
# Use case: Disable if not tracking therapy or to reduce processing time
PROCESS_THERAPY_SESSIONS=true

# PROCESS_DOCTOR_VISITS - Detect and summarize doctor/medical visits in lifelogs
# When disabled: Skips doctor visit detection and medical visit summaries
# Use case: Disable if not tracking medical appointments or to reduce processing time
# Note: Excludes psychiatrist visits (those are handled by PROCESS_THERAPY_SESSIONS)
PROCESS_DOCTOR_VISITS=true

# CREATE_WEEKLY_SUMMARIES - Generate weekly summary reports
# When disabled: Skips weekly aggregation, saves processing time
# Use case: Disable if only daily insights are needed
CREATE_WEEKLY_SUMMARIES=true

# CREATE_MONTHLY_SUMMARIES - Generate monthly summary reports
# When disabled: Skips monthly aggregation, saves processing time
# Use case: Disable if only daily/weekly insights are needed
CREATE_MONTHLY_SUMMARIES=true

# CREATE_THERAPY_MONTHLY_SUMMARIES - Generate monthly therapy progress summaries
# When disabled: Skips monthly therapy summary generation
# Use case: Disable if not tracking therapy or to reduce LLM API costs
# Note: Requires PROCESS_THERAPY_SESSIONS to be enabled for therapy sessions to exist
CREATE_THERAPY_MONTHLY_SUMMARIES=true

# CREATE_JOURNAL_MONTHLY_SUMMARIES - Generate monthly journal reflection summaries
# When disabled: Skips monthly journal summary generation
# Use case: Disable if not recording journal entries or to reduce LLM API costs
# Note: Requires PROCESS_JOURNAL_ENTRIES to be enabled for journal entries to exist
CREATE_JOURNAL_MONTHLY_SUMMARIES=true

# LABEL_SPEAKERS - Identify and label speakers in lifelog transcripts
# When disabled: Skips LLM-based speaker identification, faster processing
# Use case: Disable to reduce LLM API costs or speed up processing
LABEL_SPEAKERS=true

# PROCESS_BIOGRAPHIES - Extract and maintain biographical profiles for people, places, and objects
# When disabled: Skips biographical content detection and master biography file updates
# Use case: Disable if not tracking biographical information or to reduce LLM API costs
# Note: Processes journal entries, lifelogs, and bee transcriptions (NOT therapy/doctor visits)
# Creates living documents that accumulate knowledge over time about meaningful subjects
PROCESS_BIOGRAPHIES=true

# ============================================================================
# Logging Configuration
# ============================================================================
# Control logging behavior, output, and verbosity

# LOG_LEVEL - Minimum log level to display/record
# Options: DEBUG (most verbose), INFO, WARNING, ERROR, CRITICAL (least verbose)
# DEBUG: Detailed diagnostic information for troubleshooting
# INFO: General informational messages about application flow (recommended for production)
# WARNING: Potentially harmful situations that don't prevent operation
# ERROR: Error events that might still allow application to continue
# CRITICAL: Very severe errors that may cause application to abort
LOG_LEVEL=INFO

# LOG_TO_CONSOLE - Display logs in terminal
# When disabled: No console output (only file logging if enabled)
# Use case: Disable for background jobs or when only file logging desired
LOG_TO_CONSOLE=true

# LOG_TO_FILE - Save logs to file with automatic rotation
# When disabled: Logs only to console, not persisted to disk
# Use case: Disable for development if you don't need log files
LOG_TO_FILE=true

# LOG_DIR - Directory where log files are stored
# Default: logs/ (created automatically if doesn't exist)
LOG_DIR=logs

# LOG_FILE - Name of the main log file
# Rotated files will be named: daily_insights.log.1, .log.2, etc.
LOG_FILE=daily_insights.log

# LOG_MAX_BYTES - Maximum size of log file before rotation (in bytes)
# Default: 10485760 (10MB)
# When file reaches this size, it's rotated to .log.1 and a new file is created
# Examples: 5242880 (5MB), 20971520 (20MB), 52428800 (50MB)
LOG_MAX_BYTES=10485760

# LOG_BACKUP_COUNT - Number of backup log files to keep
# Default: 5 (keeps 50MB total with 10MB files)
# Oldest backup is deleted when limit is reached
# Example: With LOG_MAX_BYTES=10MB and LOG_BACKUP_COUNT=5, you keep ~50MB of logs
LOG_BACKUP_COUNT=5
