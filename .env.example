# Limitless API Configuration
LIMITLESS_API_KEY=YOUR_LIMITLESS_API_KEY_HERE
LIMITLESS_CHATS_API_BASE=https://api.limitless.ai/v1/chats
LIMITLESS_LIFELOGS_API_BASE=https://api.limitless.ai/v1/lifelogs

# LLM Provider Configuration (openai or ollama)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4

# Ollama Configuration
OLLAMA_MODEL=llama3.2

# Directory Paths (relative to project root)
LIFELOGS_DIR=lifelogs
INSIGHTS_DIR=daily
WEEKLY_DIR=weekly
MONTHLY_DIR=monthly
BEE_DIR=bee
PSYCHOLOGIST_DIR=psychologist
JOURNAL_DIR=journal

# Prompt File Paths
WEEKLY_PROMPT_FILE=prompts/weekly_prompt.txt
MONTHLY_PROMPT_FILE=prompts/monthly.txt
BEE_PROMPT_FILE=prompts/bee_daily.txt
PSYCHOLOGIST_PROMPT_FILE=prompts/psycho_analysis.txt

# Therapy Detection Parameters
THERAPY_KEYWORDS=therapy,therapist,psychologist,counseling,mental health,anxiety,depression,trauma,coping
NON_THERAPY_KEYWORDS=journal,note to self,reminder,todo,grocery,shopping,meeting,calendar
CONVERSATION_GAP_MINUTES=15

# Therapy Scoring Parameters
SCORE_DURATION_MATCH=30
SCORE_AFTERNOON=10
SCORE_KEYWORD=15
SCORE_SPEAKER_NAMES=20
SCORE_BACK_AND_FORTH=15
PENALTY_TOO_MANY_SPEAKERS=-20
PENALTY_TOO_LONG=-15
PENALTY_TOO_SHORT=-20
PENALTY_TOO_MANY_MESSAGES=-10
PENALTY_JOURNAL=-30
PENALTY_NON_THERAPY=-25
CONFIDENCE_THRESHOLD=50

# Therapy Detection Thresholds
MAX_DURATION=75
MIN_DURATION=30
MIN_MESSAGES=8
MAX_MESSAGES=100
MAX_SPEAKERS=3
